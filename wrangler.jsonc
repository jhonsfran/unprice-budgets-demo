{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unprice-budgets-demo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/unprice/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET_RUN", "class_name": "BudgetRun" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BudgetRun"] }],
  "ratelimits": [
    { "name": "RUNS_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
